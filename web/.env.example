# Copy to .env.local.
# Server-only vars (no NEXT_PUBLIC prefix): the browser never sees these — it
# talks to the same-origin proxy at /api/backend which injects them.
BACKEND_URL=http://localhost:8000
BACKEND_API_KEY=

# Optional. Set to the backend's PUBLIC origin (e.g. https://cra-api.onrender.com)
# so the browser's EventSource connects the job stream directly, bypassing
# serverless-function timeouts (Vercel). The stream endpoint is an unauthenticated
# GET; the backend must list this dashboard's origin in CORS_ORIGINS.
# Leave blank for local dev (stream goes through the proxy).
NEXT_PUBLIC_SSE_BASE=
