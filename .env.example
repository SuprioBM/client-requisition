# ============================================================
# Client Requisition Agent - environment configuration
# Copy to .env and fill in. Never commit .env.
# Comments must be on their own line (no inline "# ..." after a value).
# ============================================================

# ---- Application ----
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# API_KEY guards mutating / outreach endpoints via the X-API-Key header.
# Required when APP_ENV=production; optional (auth disabled) otherwise.
API_KEY=

# ---- Database (REQUIRED) ----
# Async driver required. Postgres/Supabase in production:
#   postgresql+asyncpg://user:pass@host:5432/dbname
# Zero-infra local option:
#   sqlite+aiosqlite:///./requisition.db
DATABASE_URL=postgresql+asyncpg://requisition:requisition@localhost:5432/requisition

# Optional Supabase REST (not used by the core V1 pipeline)
SUPABASE_URL=
SUPABASE_KEY=

# ---- Redis (REQUIRED in production) ----
# Job queue + cache. If unreachable outside production the worker falls back to
# polling the jobs table (logged loudly).
REDIS_URL=redis://localhost:6379/0

# ---- Discovery: Google Places (PRIMARY, feature-specific) ----
# Absent -> discovery falls back to DuckDuckGo + Brave.
GOOGLE_MAPS_API_KEY=

# ---- Discovery: Brave Search (SECONDARY, feature-specific) ----
BRAVE_SEARCH_API_KEY=

# ---- Research fallback: Tavily (OPTIONAL) ----
# Absent -> the selective research fallback is disabled.
TAVILY_API_KEY=

# ---- LLM: Groq (REQUIRED for evaluation / outreach) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Website research ----
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_ENABLED=true
RESEARCH_HTTP_TIMEOUT_SECONDS=15
RESEARCH_MAX_RESPONSE_BYTES=3000000
RESEARCH_CACHE_TTL_SECONDS=604800
RESEARCH_USER_AGENT=ClientRequisitionAgent/1.0 (+contact you@example.com)
# SSRF guard. Keep false unless you really need to research private hosts.
ALLOW_PRIVATE_NETWORK_RESEARCH=false

# ---- Concurrency / cost control ----
DISCOVERY_PROVIDER_CONCURRENCY=3
RESEARCH_CONCURRENCY=4
WORKER_JOB_LEASE_SECONDS=900
MAX_QUERIES_PER_PLAN=6
RETRY_BASE_DELAY_SECONDS=2
MAX_RETRY_DELAY_SECONDS=60

# ---- Worker ----
# Unset -> the worker runs embedded in the API process when APP_ENV=development.
# Set false to require a separate `python -m app.workers.worker`.
RUN_EMBEDDED_WORKER=

# ---- LangGraph checkpointing ----
# Empty -> local sqlite file. Or a postgresql:// URL for multi-worker safety.
LANGGRAPH_CHECKPOINT_DB=

# ---- Outreach ----
OUTREACH_SENDER_NAME=Suprio
OUTREACH_FOLLOW_UP_DAYS=5
OUTREACH_MAX_FOLLOW_UPS=2
# Optional real email sending (SMTP). Absent -> sends are reported NOT_CONFIGURED.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# ---- Service catalogue ----
# Optional path to a JSON file overriding the default service taxonomy.
SERVICES_KB_PATH=
